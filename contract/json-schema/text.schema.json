{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://oa-explorer.invalid/contract/0.1.0/entities/text.json",
  "title": "Text row (language layer)",
  "description": "One CSV row of texts.csv. Contract 0.1.0 (DRAFT). CSV cells are strings; types are checked after CSV parsing. x-column-order is the canonical CSV column order.",
  "type": "object",
  "x-entity-file": "texts.csv",
  "x-column-order": [
    "entity_id",
    "field",
    "lang",
    "language_status",
    "text",
    "review_state",
    "public_visible",
    "approved_by",
    "approved_date",
    "withhold_reason",
    "legacy_ref",
    "created_by",
    "created_date",
    "last_reviewed_by",
    "last_reviewed_date",
    "change_note",
    "data_origin"
  ],
  "properties": {
    "entity_id": {
      "type": "string",
      "pattern": "^([A-Z]{2}|[OFVMP]-[A-Z]{2}-\\d{4}|R-\\d{4})$"
    },
    "field": {
      "type": "string"
    },
    "lang": {
      "type": "string",
      "pattern": "^[a-z]{2,3}(-[A-Za-z0-9]{2,8})*$"
    },
    "language_status": {
      "type": "string",
      "enum": [
        "original",
        "translation",
        "gloss"
      ]
    },
    "text": {
      "type": "string"
    },
    "review_state": {
      "type": "string",
      "enum": [
        "draft",
        "unreviewed",
        "in_review",
        "reviewed",
        "approved_public"
      ]
    },
    "public_visible": {
      "type": "boolean"
    },
    "approved_by": {
      "type": "string"
    },
    "approved_date": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "withhold_reason": {
      "type": "string"
    },
    "legacy_ref": {
      "type": "string"
    },
    "created_by": {
      "type": "string"
    },
    "created_date": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "last_reviewed_by": {
      "type": "string"
    },
    "last_reviewed_date": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "change_note": {
      "type": "string"
    },
    "data_origin": {
      "type": "string",
      "enum": [
        "synthetic",
        "corpus"
      ]
    }
  },
  "required": [
    "entity_id",
    "field",
    "lang",
    "language_status",
    "text",
    "review_state",
    "public_visible",
    "data_origin"
  ],
  "additionalProperties": false
}
