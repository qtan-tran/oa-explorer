{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://oa-explorer.invalid/contract/0.1.0/entities/policy_family.json",
  "title": "Policy family row",
  "description": "One CSV row of policy_families.csv. Contract 0.1.0 (DRAFT). CSV cells are strings; types are checked after CSV parsing. x-column-order is the canonical CSV column order.",
  "type": "object",
  "x-entity-file": "policy_families.csv",
  "x-column-order": [
    "family_id",
    "issuer_org_id",
    "authority_level",
    "instrument_function",
    "policy_area",
    "scope_note",
    "review_state",
    "public_visible",
    "approved_by",
    "approved_date",
    "withhold_reason",
    "legacy_ref",
    "created_by",
    "created_date",
    "last_reviewed_by",
    "last_reviewed_date",
    "change_note",
    "data_origin"
  ],
  "properties": {
    "family_id": {
      "type": "string",
      "pattern": "^F-[A-Z]{2}-\\d{4}$"
    },
    "issuer_org_id": {
      "type": "string",
      "pattern": "^O-[A-Z]{2}-\\d{4}$"
    },
    "authority_level": {
      "type": "string",
      "enum": [
        "institutional",
        "funder",
        "national",
        "institutional_within_national"
      ]
    },
    "instrument_function": {
      "type": "string",
      "enum": [
        "national_assessment_subsidy_rules",
        "funder_grant_terms",
        "institutional_oa_os_policy",
        "repository_rules",
        "apc_eligibility",
        "implementation_guidance",
        "announcement"
      ]
    },
    "policy_area": {
      "type": "string",
      "enum": [
        "OA",
        "Mixed",
        "OS"
      ]
    },
    "scope_note": {
      "type": "string"
    },
    "review_state": {
      "type": "string",
      "enum": [
        "draft",
        "unreviewed",
        "in_review",
        "reviewed",
        "approved_public"
      ]
    },
    "public_visible": {
      "type": "boolean"
    },
    "approved_by": {
      "type": "string"
    },
    "approved_date": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "withhold_reason": {
      "type": "string"
    },
    "legacy_ref": {
      "type": "string"
    },
    "created_by": {
      "type": "string"
    },
    "created_date": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "last_reviewed_by": {
      "type": "string"
    },
    "last_reviewed_date": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "change_note": {
      "type": "string"
    },
    "data_origin": {
      "type": "string",
      "enum": [
        "synthetic",
        "corpus"
      ]
    }
  },
  "required": [
    "family_id",
    "issuer_org_id",
    "authority_level",
    "instrument_function",
    "policy_area",
    "review_state",
    "public_visible",
    "data_origin"
  ],
  "additionalProperties": false
}
