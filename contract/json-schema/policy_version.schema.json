    "effective_date_iso",
    "effective_date_precision",
    "effective_date_basis",
    "effective_date_confidence",
    "effective_date_verbatim",
    "evidence_confidence",
    "special_stratum",
    "score_ms_mandate_strength",
    "score_ms_mandate_strength_value_state",
    "score_rl_rights_licensing",
    "score_rl_rights_licensing_value_state",
    "score_comp_compliance",
    "score_comp_compliance_value_state",
    "score_inf_infrastructure",
