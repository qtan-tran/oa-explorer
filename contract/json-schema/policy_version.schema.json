  "properties": {
    "version_id": {
      "type": "string",
      "pattern": "^V-[A-Z]{2}-\\d{4}$"
    },
    "family_id": {
      "type": "string",
      "pattern": "^F-[A-Z]{2}-\\d{4}$"
    },
    "version_label": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "in_force",
        "superseded",
        "withdrawn",
        "repealed",
        "unknown"
      ]
    },
    "official_languages": {
      "type": "string",
      "pattern": "^[a-z]{2,3}(-[A-Za-z0-9]{2,8})*(\\|[a-z]{2,3}(-[A-Za-z0-9]{2,8})*)*$"
    },
    "adopted_date_iso": {
      "type": "string",
      "pattern": "^$|^\\d{4}$|^\\d{4}-\\d{2}$|^\\d{4}-\\d{2}-\\d{2}$"
    },
    "adopted_date_precision": {
      "type": "string",
      "enum": [
        "year",
        "month",
        "day",
        ""
      ]
    },
    "adopted_date_basis": {
      "type": "string",
      "enum": [
        "adopted",
        "effective",
        "published",
        "inferred",
        "unknown",
        ""
