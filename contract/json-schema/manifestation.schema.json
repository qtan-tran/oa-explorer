{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://oa-explorer.invalid/contract/0.1.0/entities/manifestation.json",
  "title": "Source manifestation row",
  "description": "One CSV row of manifestations.csv. Contract 0.1.0 (DRAFT). CSV cells are strings; types are checked after CSV parsing. x-column-order is the canonical CSV column order.",
  "type": "object",
  "x-entity-file": "manifestations.csv",
  "x-column-order": [
    "manifestation_id",
    "version_id",
    "form",
    "language",
    "verbatim_title",
    "live_url",
    "live_url_value_state",
    "archived_url",
    "archived_url_value_state",
    "archive_date",
    "archive_service",
    "retrieved_date",
    "access_status",
    "storage_ref",
    "rights_status",
    "redistribution",
    "attribution_required",
    "excerpt_policy",
    "permission_evidence",
    "permission_reviewed_by",
    "permission_reviewed_date",
    "review_state",
    "public_visible",
    "approved_by",
    "approved_date",
    "withhold_reason",
    "legacy_ref",
    "created_by",
    "created_date",
    "last_reviewed_by",
    "last_reviewed_date",
    "change_note",
    "data_origin"
  ],
  "properties": {
    "manifestation_id": {
      "type": "string",
      "pattern": "^M-[A-Z]{2}-\\d{4}$"
    },
    "version_id": {
      "type": "string",
      "pattern": "^V-[A-Z]{2}-\\d{4}$"
    },
    "form": {
      "type": "string",
      "enum": [
        "html",
        "pdf",
        "doc",
        "print",
        "other"
      ]
    },
    "language": {
      "type": "string",
      "pattern": "^[a-z]{2,3}(-[A-Za-z0-9]{2,8})*$"
    },
    "verbatim_title": {
      "type": "string"
    },
    "live_url": {
      "type": "string"
    },
    "live_url_value_state": {
      "type": "string",
      "enum": [
        "measured",
        "reviewed_absent",
        "not_applicable",
        "unknown"
      ]
    },
    "archived_url": {
      "type": "string"
    },
    "archived_url_value_state": {
      "type": "string",
      "enum": [
        "measured",
        "reviewed_absent",
        "not_applicable",
        "unknown"
      ]
    },
    "archive_date": {
      "type": "string",
      "pattern": "^$|^\\d{4}-\\d{2}-\\d{2}$"
    },
    "archive_service": {
      "type": "string"
    },
    "retrieved_date": {
      "type": "string",
      "pattern": "^$|^\\d{4}-\\d{2}-\\d{2}$"
    },
    "access_status": {
      "type": "string",
      "enum": [
        "open_public",
        "open_login",
        "restricted",
        "removed",
        "unrecovered"
      ]
    },
    "storage_ref": {
      "type": "string"
    },
    "rights_status": {
      "type": "string",
      "enum": [
        "public_domain",
        "open_license",
        "copyright_all_rights",
        "mixed",
        "unknown"
      ]
    },
    "redistribution": {
      "type": "string",
      "enum": [
        "permitted",
        "not_permitted",
        "unknown"
      ]
    },
    "attribution_required": {
      "type": "string",
      "enum": [
        "yes",
        "no",
        "unknown"
      ]
    },
    "excerpt_policy": {
      "type": "string",
      "enum": [
        "quotation_exception",
        "permitted",
        "not_permitted",
        "unknown"
      ]
    },
    "permission_evidence": {
      "type": "string"
    },
    "permission_reviewed_by": {
      "type": "string"
    },
    "permission_reviewed_date": {
      "type": "string",
      "pattern": "^$|^\\d{4}-\\d{2}-\\d{2}$"
    },
    "review_state": {
      "type": "string",
      "enum": [
        "draft",
        "unreviewed",
        "in_review",
        "reviewed",
        "approved_public"
      ]
    },
    "public_visible": {
      "type": "boolean"
    },
    "approved_by": {
      "type": "string"
    },
    "approved_date": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "withhold_reason": {
      "type": "string"
    },
    "legacy_ref": {
      "type": "string"
    },
    "created_by": {
      "type": "string"
    },
    "created_date": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "last_reviewed_by": {
      "type": "string"
    },
    "last_reviewed_date": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "change_note": {
      "type": "string"
    },
    "data_origin": {
      "type": "string",
      "enum": [
        "synthetic",
        "corpus"
      ]
    }
  },
  "required": [
    "manifestation_id",
    "version_id",
    "form",
    "language",
    "access_status",
    "rights_status",
    "redistribution",
    "attribution_required",
    "excerpt_policy",
    "review_state",
    "public_visible",
    "data_origin"
  ],
  "additionalProperties": false
}
