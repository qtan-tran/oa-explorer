{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://oa-explorer.invalid/contract/0.1.0/entities/provision.json",
  "title": "Provision row",
  "description": "One CSV row of provisions.csv. Contract 0.1.0 (DRAFT). CSV cells are strings; types are checked after CSV parsing. x-column-order is the canonical CSV column order.",
  "type": "object",
  "x-entity-file": "provisions.csv",
  "x-column-order": [
    "provision_id",
    "version_id",
    "manifestation_id",
    "modality",
    "actor",
    "action",
    "object",
    "scope",
    "conditions",
    "conditions_value_state",
    "exceptions",
    "exceptions_value_state",
    "excerpt_text",
    "excerpt_language",
    "excerpt_value_state",
    "anchor",
    "anchor_url_fragment",
    "review_extent",
    "uncertainty_note",
    "review_state",
    "public_visible",
    "approved_by",
    "approved_date",
    "withhold_reason",
    "legacy_ref",
    "created_by",
    "created_date",
    "last_reviewed_by",
    "last_reviewed_date",
    "change_note",
    "data_origin"
  ],
  "properties": {
    "provision_id": {
      "type": "string",
      "pattern": "^P-[A-Z]{2}-\\d{4}$"
    },
    "version_id": {
      "type": "string",
      "pattern": "^V-[A-Z]{2}-\\d{4}$"
    },
    "manifestation_id": {
      "type": "string",
      "pattern": "^M-[A-Z]{2}-\\d{4}$"
    },
    "modality": {
      "type": "string",
      "enum": [
        "obligation",
        "expectation",
        "recommendation",
        "permission",
        "prohibition",
        "incentive",
        "exemption",
        "commitment",
        "description"
      ]
    },
    "actor": {
      "type": "string"
    },
    "action": {
      "type": "string"
    },
    "object": {
      "type": "string"
    },
    "scope": {
      "type": "string"
    },
    "conditions": {
      "type": "string"
    },
    "conditions_value_state": {
      "type": "string",
      "enum": [
        "measured",
        "reviewed_absent",
        "not_applicable",
        "unknown"
      ]
    },
    "exceptions": {
      "type": "string"
    },
    "exceptions_value_state": {
      "type": "string",
      "enum": [
        "measured",
        "reviewed_absent",
        "not_applicable",
        "unknown"
      ]
    },
    "excerpt_text": {
      "type": "string"
    },
    "excerpt_language": {
      "type": "string",
      "pattern": "^[a-z]{2,3}(-[A-Za-z0-9]{2,8})*$"
    },
    "excerpt_value_state": {
      "type": "string",
      "enum": [
        "measured",
        "reviewed_absent",
        "not_applicable",
        "unknown"
      ]
    },
    "anchor": {
      "type": "string"
    },
    "anchor_url_fragment": {
      "type": "string"
    },
    "review_extent": {
      "type": "string",
      "enum": [
        "full_text",
        "selected_sections",
        "summary_document"
      ]
    },
    "uncertainty_note": {
      "type": "string"
    },
    "review_state": {
      "type": "string",
      "enum": [
        "draft",
        "unreviewed",
        "in_review",
        "reviewed",
        "approved_public"
      ]
    },
    "public_visible": {
      "type": "boolean"
    },
    "approved_by": {
      "type": "string"
    },
    "approved_date": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "withhold_reason": {
      "type": "string"
    },
    "legacy_ref": {
      "type": "string"
    },
    "created_by": {
      "type": "string"
    },
    "created_date": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "last_reviewed_by": {
      "type": "string"
    },
    "last_reviewed_date": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "change_note": {
      "type": "string"
    },
    "data_origin": {
      "type": "string",
      "enum": [
        "synthetic",
        "corpus"
      ]
    }
  },
  "required": [
    "provision_id",
    "version_id",
    "manifestation_id",
    "modality",
    "actor",
    "action",
    "object",
    "excerpt_value_state",
    "review_extent",
    "review_state",
    "public_visible",
    "data_origin"
  ],
  "additionalProperties": false
}
